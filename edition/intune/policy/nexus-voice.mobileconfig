<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nexus Voice managed preferences for Intune (Devices > macOS > Configuration > Templates > Custom).
     Keys in the nexus.voice domain; remove a key to leave that feature to people.
     Available keys: ManagedModelsOnly, DisableLabs, DisableOpenCodeProcessing,
     DisableTransforms, RestrictTransformsToLoopback, DisableMeetings, DisableAnnotate.
     The two UUIDs must be unique per profile; regenerate them with uuidgen if you copy this. -->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>nexus.voice</string>
			<key>PayloadIdentifier</key>
			<string>nexus.voice.policy.settings</string>
			<key>PayloadUUID</key>
			<string>6B1E2C3D-4A5F-4E6A-9B7C-8D9E0F1A2B3C</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>ManagedModelsOnly</key>
			<true/>
			<key>DisableLabs</key>
			<true/>
			<key>DisableOpenCodeProcessing</key>
			<true/>
			<key>DisableTransforms</key>
			<true/>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>Nexus Voice policy</string>
	<key>PayloadIdentifier</key>
	<string>nexus.voice.policy</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>1F2E3D4C-5B6A-4798-8A9B-0C1D2E3F4A5B</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
